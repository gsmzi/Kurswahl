<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button">
    <Setter Property="Background" Value="#F3F6F8" />
    <Setter Property="BorderBrush" Value="#DAE3E9" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#176B68" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="#176B68" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#105350" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0B413F" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#526476" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="#E2F1EE" />
    <Setter Property="Foreground" Value="#105350" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="Margin" Value="0,4" />
  </Style>
</Styles>
