{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gsm-kurswahl:course-choice:1",
  "title": "GSM-Kurswahl Schülerwahl v1 – nicht vertrauenswürdiger Entwurf",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "studentId", "graduationYear", "offerVersion", "ruleVersion", "revision", "createdAt", "updatedAt", "submissionStatus", "phase", "selections"],
  "properties": {
    "schemaVersion": {"const": 1},
    "documentId": {"type": "string", "format": "uuid"},
    "studentId": {"type": "string", "minLength": 1},
    "graduationYear": {"type": "integer", "minimum": 2000, "maximum": 2200},
    "offerVersion": {"type": "string", "minLength": 1},
    "ruleVersion": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "submissionStatus": {"enum": ["draft", "submitted"]},
    "phase": {"enum": ["preliminary", "final"]},
    "selections": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["offerId", "subjectId", "type", "variant", "semesters"],
        "properties": {
          "offerId": {"type": "string", "minLength": 1},
          "subjectId": {"type": "string", "minLength": 1},
          "type": {"enum": ["lf", "bf", "elective", "seminar"]},
          "variant": {"enum": ["normal", "bilingual"]},
          "semesters": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4}}
        }
      }
    }
  }
}
