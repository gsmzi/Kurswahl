{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lehrer-Netzwechsel v2 (transfer.json in .gsm-transfer ZIP)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "createdAt",
    "year",
    "databaseHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "year": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "databasePath",
        "step",
        "actor"
      ],
      "properties": {
        "catalog": {
          "oneOf": [
            {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "urn:gsm-kurswahl:offer-catalog:2",
              "title": "GSM-Kurswahl Fachangebot v2 (Fachmerkmale taskField/isForeignLanguage/isScience)",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schemaVersion",
                "version",
                "graduationYear",
                "isDemo",
                "subjects",
                "offers"
              ],
              "properties": {
                "schemaVersion": {
                  "enum": [
                    1,
                    2
                  ]
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "graduationYear": {
                  "type": "integer",
                  "minimum": 2000,
                  "maximum": 2200
                },
                "isDemo": {
                  "type": "boolean"
                },
                "subjects": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "name"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "taskField": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 3
                      },
                      "isForeignLanguage": {
                        "type": "boolean"
                      },
                      "isScience": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "offers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "subjectId",
                      "type",
                      "variant",
                      "status",
                      "schedule",
                      "requirements"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "subjectId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "type": {
                        "enum": [
                          "lf",
                          "bf",
                          "elective",
                          "seminar"
                        ]
                      },
                      "variant": {
                        "enum": [
                          "normal",
                          "bilingual"
                        ]
                      },
                      "status": {
                        "enum": [
                          "planned",
                          "offered",
                          "cancelled",
                          "established"
                        ]
                      },
                      "schedule": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 4,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "semester",
                            "weeklyHours"
                          ],
                          "properties": {
                            "semester": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 4
                            },
                            "weeklyHours": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 10
                            }
                          }
                        }
                      },
                      "requirements": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "informatics",
                            "italian_profile",
                            "continuous_bilingual"
                          ]
                        }
                      }
                    }
                  }
                },
                "submissionDeadline": {
                  "type": "string",
                  "format": "date",
                  "description": "Nur Hinweis für Schüler; in der verteilten Kopie gesetzt."
                }
              }
            },
            {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "urn:gsm-kurswahl:offer-catalog:3",
              "title": "GSM-Kurswahl Fachangebot v3 mit rein beschreibenden Kursmarkierungen",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schemaVersion",
                "version",
                "graduationYear",
                "isDemo",
                "subjects",
                "offers"
              ],
              "properties": {
                "schemaVersion": {
                  "const": 3
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "graduationYear": {
                  "type": "integer",
                  "minimum": 2000,
                  "maximum": 2200
                },
                "isDemo": {
                  "type": "boolean"
                },
                "subjects": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "name"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "taskField": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 3
                      },
                      "isForeignLanguage": {
                        "type": "boolean"
                      },
                      "isScience": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "offers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "subjectId",
                      "type",
                      "variant",
                      "status",
                      "schedule",
                      "requirements",
                      "cooperationSchool",
                      "isTopUpCourse"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "subjectId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "type": {
                        "enum": [
                          "lf",
                          "bf",
                          "elective",
                          "seminar"
                        ]
                      },
                      "variant": {
                        "enum": [
                          "normal",
                          "bilingual"
                        ]
                      },
                      "status": {
                        "enum": [
                          "planned",
                          "offered",
                          "cancelled",
                          "established"
                        ]
                      },
                      "schedule": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 4,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "semester",
                            "weeklyHours"
                          ],
                          "properties": {
                            "semester": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 4
                            },
                            "weeklyHours": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 10
                            }
                          }
                        }
                      },
                      "requirements": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "informatics",
                            "italian_profile",
                            "continuous_bilingual"
                          ]
                        }
                      },
                      "cooperationSchool": {
                        "enum": [
                          "none",
                          "ewg",
                          "gsm"
                        ]
                      },
                      "isTopUpCourse": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "submissionDeadline": {
                  "type": "string",
                  "format": "date",
                  "description": "Nur Hinweis für Schüler; in der verteilten Kopie gesetzt."
                }
              }
            }
          ]
        },
        "databasePath": {
          "const": "verwaltung.db"
        },
        "step": {
          "enum": [
            "offer",
            "import",
            "mapping",
            "review",
            "complete"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "submissionDeadline": {
          "type": "string",
          "format": "date"
        },
        "studentProgramDirectory": {
          "type": "string"
        }
      }
    },
    "databaseHash": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    }
  }
}
