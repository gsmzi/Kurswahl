{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lehrer-Netzwechsel v1 (transfer.json in .gsm-transfer ZIP)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "createdAt",
    "year",
    "databaseHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "year": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "databasePath",
        "step",
        "actor",
        "certificateThumbprint",
        "keyId"
      ],
      "properties": {
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "version",
            "graduationYear",
            "isDemo",
            "subjects",
            "offers"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "graduationYear": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2200
            },
            "isDemo": {
              "type": "boolean"
            },
            "subjects": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "offers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "subjectId",
                  "type",
                  "variant",
                  "status",
                  "schedule",
                  "requirements"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subjectId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "enum": [
                      "lf",
                      "bf",
                      "elective",
                      "seminar"
                    ]
                  },
                  "variant": {
                    "enum": [
                      "normal",
                      "bilingual"
                    ]
                  },
                  "status": {
                    "enum": [
                      "planned",
                      "offered",
                      "cancelled",
                      "established"
                    ]
                  },
                  "schedule": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "semester",
                        "weeklyHours"
                      ],
                      "properties": {
                        "semester": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 4
                        },
                        "weeklyHours": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10
                        }
                      }
                    }
                  },
                  "requirements": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "informatics",
                        "italian_profile",
                        "continuous_bilingual"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "databasePath": {
          "const": "verwaltung.db"
        },
        "step": {
          "enum": [
            "offer",
            "import",
            "mapping",
            "review",
            "complete"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "certificateThumbprint": {
          "type": "string"
        },
        "keyId": {
          "type": "string"
        }
      }
    },
    "databaseHash": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    }
  }
}
