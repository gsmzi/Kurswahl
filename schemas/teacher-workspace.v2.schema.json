{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lokale Lehrer-Jahrgangsverwaltung v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "activeYear",
    "years"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "activeYear": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 2000,
      "maximum": 2200
    },
    "years": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalog",
          "databasePath",
          "step",
          "actor"
        ],
        "properties": {
          "catalog": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "version",
              "graduationYear",
              "isDemo",
              "subjects",
              "offers"
            ],
            "properties": {
              "schemaVersion": {
                "enum": [
                  1,
                  2
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "graduationYear": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2200
              },
              "isDemo": {
                "type": "boolean"
              },
              "subjects": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "taskField": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 3
                    },
                    "isForeignLanguage": {
                      "type": "boolean"
                    },
                    "isScience": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "offers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "subjectId",
                    "type",
                    "variant",
                    "status",
                    "schedule",
                    "requirements"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "subjectId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "enum": [
                        "lf",
                        "bf",
                        "elective",
                        "seminar"
                      ]
                    },
                    "variant": {
                      "enum": [
                        "normal",
                        "bilingual"
                      ]
                    },
                    "status": {
                      "enum": [
                        "planned",
                        "offered",
                        "cancelled",
                        "established"
                      ]
                    },
                    "schedule": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "semester",
                          "weeklyHours"
                        ],
                        "properties": {
                          "semester": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 4
                          },
                          "weeklyHours": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 10
                          }
                        }
                      }
                    },
                    "requirements": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "informatics",
                          "italian_profile",
                          "continuous_bilingual"
                        ]
                      }
                    }
                  }
                }
              },
              "submissionDeadline": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "databasePath": {
            "type": "string",
            "minLength": 1
          },
          "step": {
            "enum": [
              "offer",
              "import",
              "mapping",
              "review",
              "complete"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "submissionDeadline": {
            "type": "string",
            "format": "date"
          },
          "studentProgramDirectory": {
            "type": "string"
          }
        }
      }
    }
  }
}
