{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gsm-kurswahl:offer-catalog:1",
  "title": "GSM-Kurswahl Fachangebot v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "version", "graduationYear", "isDemo", "subjects", "offers"],
  "properties": {
    "schemaVersion": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "graduationYear": {"type": "integer", "minimum": 2000, "maximum": 2200},
    "isDemo": {"type": "boolean"},
    "subjects": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}
    }},
    "offers": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subjectId", "type", "variant", "status", "schedule", "requirements"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "subjectId": {"type": "string", "minLength": 1},
        "type": {"enum": ["lf", "bf", "elective", "seminar"]},
        "variant": {"enum": ["normal", "bilingual"]},
        "status": {"enum": ["planned", "offered", "cancelled", "established"]},
        "schedule": {"type": "array", "minItems": 1, "maxItems": 4, "items": {
          "type": "object", "additionalProperties": false, "required": ["semester", "weeklyHours"],
          "properties": {"semester": {"type": "integer", "minimum": 1, "maximum": 4}, "weeklyHours": {"type": "integer", "minimum": 1, "maximum": 10}}
        }},
        "requirements": {"type": "array", "items": {"enum": ["informatics", "italian_profile", "continuous_bilingual"]}}
      }
    }}
  }
}
